---
import Layout from '@/layouts/Layout.astro'
import { releases } from '@/data/releases'

const epkPhotos = [
  { src: '/photos/exit_wounds/1.webp', caption: 'Promo · primary', ext: 'WEBP' },
  { src: '/photos/exit_wounds/2.webp', caption: 'Promo · alley', ext: 'WEBP' },
  { src: '/photos/exit_wounds/3.webp', caption: 'Promo · church', ext: 'WEBP' },
  { src: '/photos/live/poppari_2025/_X2A6176.webp', caption: 'Live · Poppari', ext: 'WEBP' },
  { src: '/photos/live/poppari_2025/_X2A7434.webp', caption: 'Live · crowd', ext: 'WEBP' },
  { src: '/photos/exit_wounds/4.webp', caption: 'Promo · color', ext: 'WEBP' },
]

const members = [
  { num: '01', name: 'Kristian Ruutala',    role: 'Harsh Vocals' },
  { num: '02', name: 'Aleksi Statsevich',   role: 'Harsh Vocals' },
  { num: '03', name: 'Aavee Tikkanen',      role: 'Vocals · Guitar' },
  { num: '04', name: 'Aleksi Ruotsalainen', role: 'Guitar' },
  { num: '05', name: 'Jimi Kinnunen',       role: 'Drums' },
]
---

<Layout
  title="In Thorns — Electronic Press Kit 2026"
  description="Official EPK for In Thorns — Finnish metalcore collective, Jyväskylä. Bio, facts, press, photos, releases, booking."
  noindex={true}
>

<header class="epk-top">
  <div class="epk-top__logo">IN THORNS</div>
  <div class="epk-top__tag">Electronic Press Kit · 2026</div>
  <div class="epk-top__actions">
    <a class="it-chip" href="mailto:inthornsband@gmail.com?subject=EPK%20%E2%80%94%20Press%20enquiry">Contact</a>
    <a class="it-chip" href="/">Website →</a>
  </div>
</header>

<main class="epk-wrap">

  <!-- HERO -->
  <section class="epk-hero">
    <div>
      <div class="epk-hero__eyebrow">Electronic Press Kit</div>
      <h1>In<br /><em>Thorns.</em></h1>
    </div>
    <p class="epk-hero__sub">
      <strong>Finnish metalcore collective from Jyväskylä.</strong> New single <em>"wormhusk"</em> out now (May 29, 2026). Crushing soundscapes, darkly poetic lyrics, surrealist horror staging.
    </p>
  </section>

  <!-- A0 QUICK FACTS -->
  <section class="epk-sec" id="facts">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A0 / At a glance<small>Copy-paste facts</small></div>
      <div>
        <h2>Quick facts</h2>
        <div class="bio__facts">
          <div class="fact"><div class="fact__k">Origin</div><div class="fact__v">Jyväskylä</div><div class="fact__sub">Central Finland · est. 2022</div></div>
          <div class="fact"><div class="fact__k">Genre</div><div class="fact__v">Metalcore</div><div class="fact__sub">Post · alternative · surrealist</div></div>
          <div class="fact"><div class="fact__k">Members</div><div class="fact__v">5</div><div class="fact__sub">Two-vocalist attack</div></div>
          <div class="fact"><div class="fact__k">Accolades</div><div class="fact__v">NCY '24</div><div class="fact__sub">Kaaoszine readers' poll</div></div>
        </div>
        <div class="epk-statband">
          <div class="stat"><div class="stat__n">02</div><div class="stat__k">Singles · 2026</div><div class="stat__sub">exit wounds · wormhusk</div></div>
          <div class="stat"><div class="stat__n">01</div><div class="stat__k">Album</div><div class="stat__sub">tlbocs · 2024</div></div>
          <div class="stat"><div class="stat__n">06</div><div class="stat__k">Tour dates</div><div class="stat__sub">Spring 2026 · FI</div></div>
          <div class="stat"><div class="stat__n">FI</div><div class="stat__k">Territory</div><div class="stat__sub">EN / FI press</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- A1 BIO -->
  <section class="epk-sec" id="bio">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A1 / Biography<small>Long · short · one-liner</small></div>
      <div class="epk-bio">
        <h2>Biography</h2>
        <p>
          Jyväskylä-based Finnish metalcore collective <strong>In Thorns</strong> releases new single <em>"wormhusk"</em> on May 29, 2026 — the second chapter of a new cycle following <em>"exit wounds"</em> (January 2026) and their acclaimed debut album <em>"the last bead on a cord of songs"</em> (2024), which earned Newcomer of the Year recognition in Kaaoszine's readers' poll.
        </p>
        <p>
          The collective creates metalcore driven by crushing soundscapes, nihilistic and darkly poetic lyrics, and soaring melodies. Drawing on surrealist art and horror, In Thorns delivers an immersive experience that balances devastating heaviness with haunting beauty. Live, the band's tight, high-energy performance pulls audiences into a dark, surreal world.
        </p>
        <div class="epk-bio__variants">
          <div class="epk-bio__variant">
            <div class="vk"><span>Short bio</span><span>~50 words</span></div>
            <p>In Thorns is a five-piece metalcore collective from Jyväskylä, Finland. Following Newcomer of the Year acclaim for their 2024 debut, the band's 2026 cycle — singles "exit wounds" and "wormhusk" — pairs crushing weight with surrealist, horror-tinged staging and darkly poetic lyrics.</p>
          </div>
          <div class="epk-bio__variant">
            <div class="vk"><span>One-liner</span><span>For listings</span></div>
            <p>Finnish metalcore collective from Jyväskylä — crushing, poetic, surreal. New single "wormhusk" out now.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A2 MEMBERS -->
  <section class="epk-sec" id="members">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A2 / Line-up<small>Five members</small></div>
      <div>
        <h2>Line-up</h2>
        <div class="members">
          {members.map(m => (
            <div class="member">
              <div class="member__num">{m.num}</div>
              <div class="member__name">{m.name}</div>
              <div class="member__role">{m.role}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- A3 RELEASES -->
  <section class="epk-sec" id="releases">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A3 / Releases<small>2024 → 2026</small></div>
      <div>
        <h2>Releases</h2>
        <div class="releases releases--even">
          {releases.filter(r => r.type === 'single').map(r => (
            <article class={`release release--${r.theme}`}>
              <span class="release__tag">{r.tag}</span>
              <div class="release__cover">
                <img src={r.cover} alt={`${r.title} artwork`} width="600" height="600" loading="lazy" />
              </div>
              <div class="release__meta">{r.meta}</div>
              <h3 class="release__title">{r.title}</h3>
              <p class="release__desc">{r.desc}</p>
              <div class="release__links">
                {r.links.slice(0, 2).map(link => (
                  <a class="it-chip" href={link.url} target="_blank" rel="noopener">{link.label}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
        {releases.filter(r => r.type === 'album').map(r => (
          <div class="epk-album-row">
            <article class={`release release--${r.theme}`}>
              <span class="release__tag">{r.tag}</span>
              <div class="release__cover epk-album-cover">
                <img src={r.cover} alt={`${r.title} artwork`} width="600" height="600" loading="lazy" />
              </div>
              <div class="release__meta">{r.meta}</div>
              <h3 class="release__title">{r.title}</h3>
              <p class="release__desc">{r.desc}</p>
              <div class="release__links">
                {r.links.map(link => (
                  <a class="it-chip" href={link.url} target="_blank" rel="noopener">{link.label}</a>
                ))}
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- A4 PRESS -->
  <section class="epk-sec" id="press">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A4 / Press<small>Pull quotes</small></div>
      <div>
        <h2>Press</h2>
        <figure class="pullquote">
          <div class="pullquote__mark" aria-hidden="true">"</div>
          <blockquote>Live, they don't perform — <em>they invoke.</em></blockquote>
          <figcaption class="pullquote__src">— Inferno Magazine</figcaption>
        </figure>
        <div class="press-grid">
          <figure class="quote">
            <div class="quote__mark">"</div>
            <blockquote class="quote__text">A debut that arrived fully-formed — crushing, poetic, and fearless.</blockquote>
            <figcaption class="quote__src">— KAAOSZINE · NCY 2024</figcaption>
          </figure>
          <figure class="quote">
            <div class="quote__mark">"</div>
            <blockquote class="quote__text">Equal parts devastating and beautiful. The quiet parts hit as hard as the loud ones.</blockquote>
            <figcaption class="quote__src">— SOUNDI / PRINT</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- A5 PHOTOS -->
  <section class="epk-sec" id="photos">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A5 / Photos<small>Hi-res · credit required</small></div>
      <div>
        <h2>Press photos</h2>
        <div class="epk-photos">
          {epkPhotos.map(photo => (
            <figure class="epk-photo">
              <img src={photo.src} alt={`In Thorns press photo — ${photo.caption}`} loading="lazy" />
              <figcaption class="epk-photo__dl">
                <span>{photo.caption}</span>
                <b>{photo.ext} ↓</b>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="epk-photo-credit">Photo credit: on file · request originals via booking email</p>
      </div>
    </div>
  </section>

  <!-- A6 DOWNLOADS -->
  <section class="epk-sec" id="downloads">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A6 / Assets<small>Download bundle</small></div>
      <div>
        <h2>Downloads</h2>
        <div class="epk-files">
          <a class="epk-file" href="mailto:inthornsband@gmail.com?subject=EPK%20%E2%80%94%20Photo%20pack">
            <span class="epk-file__ext">ZIP</span>
            <span class="epk-file__m"><span class="epk-file__n">Photo pack</span><span class="epk-file__s">Hi-res promo + live · ~40 MB</span></span>
            <span class="epk-file__arrow">↓</span>
          </a>
          <a class="epk-file" href="mailto:inthornsband@gmail.com?subject=EPK%20%E2%80%94%20Logo%20pack">
            <span class="epk-file__ext">SVG</span>
            <span class="epk-file__m"><span class="epk-file__n">Logo pack</span><span class="epk-file__s">Wordmark · mono + cream</span></span>
            <span class="epk-file__arrow">↓</span>
          </a>
          <a class="epk-file" href="#" onclick="window.print();return false;">
            <span class="epk-file__ext">PDF</span>
            <span class="epk-file__m"><span class="epk-file__n">This EPK</span><span class="epk-file__s">Print / save as PDF</span></span>
            <span class="epk-file__arrow">↓</span>
          </a>
          <a class="epk-file" href="https://open.spotify.com/artist/4b0Yziy8xm1VtefVI9ri2d" target="_blank" rel="noopener">
            <span class="epk-file__ext">DSP</span>
            <span class="epk-file__m"><span class="epk-file__n">Streaming links</span><span class="epk-file__s">Spotify · Apple · YT · Deezer</span></span>
            <span class="epk-file__arrow">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- A7 CONTACT -->
  <section class="epk-sec epk-sec--last" id="contact">
    <div class="epk-sec__grid">
      <div class="epk-sec__label">A7 / Contact<small>Booking · press</small></div>
      <div>
        <h2>Contact</h2>
        <div class="epk-spec">
          <div class="contact__list">
            <div class="contact__row"><div class="contact__k">Booking</div><div class="contact__v"><a href="mailto:inthornsband@gmail.com">inthornsband@gmail.com</a></div></div>
            <div class="contact__row"><div class="contact__k">Based</div><div class="contact__v">Jyväskylä, Finland</div></div>
          </div>
          <div class="contact__list">
            <div class="contact__row"><div class="contact__k">Spotify</div><div class="contact__v"><a href="https://open.spotify.com/artist/4b0Yziy8xm1VtefVI9ri2d" target="_blank" rel="noopener">@InThorns</a></div></div>
            <div class="contact__row"><div class="contact__k">Instagram</div><div class="contact__v"><a href="https://www.instagram.com/inxthorns/" target="_blank" rel="noopener">@inxthorns</a></div></div>
            <div class="contact__row"><div class="contact__k">YouTube</div><div class="contact__v"><a href="https://www.youtube.com/@inthornsband" target="_blank" rel="noopener">@inthornsband</a></div></div>
          </div>
        </div>
        <div class="epk-contact-cta">
          <a class="it-btn it-btn--primary" href="mailto:inthornsband@gmail.com">
            <span>inthornsband@gmail.com</span><span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</main>

<footer class="epk-footer">
  <div class="epk-wrap epk-footer__row">
    <div>© 2026 IN THORNS · Jyväskylä, FI</div>
    <div>EPK · The pain won't cease.</div>
  </div>
</footer>

</Layout>

<style>
  /* ---- EPK layout wrapper ---- */
  .epk-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* ---- Sticky header ---- */
  .epk-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--it-orange-30);
    padding: 28px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .epk-top__logo {
    font-family: var(--it-font-display);
    font-size: 22px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--it-cream);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .epk-top__logo::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--it-orange);
  }

  .epk-top__tag {
    font-family: var(--it-font-mono);
    font-size: 11px;
    letter-spacing: var(--it-track-mono-md);
    text-transform: uppercase;
    color: rgba(245, 245, 220, 0.6);
  }

  .epk-top__actions {
    display: flex;
    gap: 10px;
  }

  /* ---- Hero ---- */
  .epk-hero {
    padding: 80px 0 64px;
    border-bottom: 1px solid var(--it-orange-30);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
    align-items: end;
  }

  .epk-hero__eyebrow {
    font-family: var(--it-font-mono);
    font-size: 12px;
    letter-spacing: var(--it-track-mono-lg);
    color: var(--it-orange);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 26px;
  }

  .epk-hero__eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--it-orange);
  }

  .epk-hero h1 {
    font-family: var(--it-font-display);
    font-size: clamp(72px, 13vw, 180px);
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--it-cream);
    margin: 0;
  }

  .epk-hero h1 em {
    font-style: normal;
    color: var(--it-orange);
    display: block;
  }

  .epk-hero__sub {
    font-family: var(--it-font-body);
    font-size: 18px;
    line-height: 1.5;
    opacity: 0.82;
    color: var(--it-cream);
    margin: 0;
  }

  .epk-hero__sub strong { color: var(--it-cream); }
  .epk-hero__sub em { font-style: italic; color: var(--it-orange); }

  /* ---- Sections ---- */
  .epk-sec {
    padding: 72px 0;
    border-bottom: 1px solid var(--it-orange-30);
    scroll-margin-top: 90px;
  }

  .epk-sec--last { border-bottom: none; }

  .epk-sec__grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 40px;
    align-items: start;
  }

  .epk-sec__label {
    font-family: var(--it-font-mono);
    font-size: 12px;
    letter-spacing: var(--it-track-mono-md);
    text-transform: uppercase;
    color: var(--it-orange);
    position: sticky;
    top: 100px;
  }

  .epk-sec__label small {
    display: block;
    font-family: var(--it-font-mono);
    font-size: 10px;
    color: rgba(245, 245, 220, 0.45);
    letter-spacing: var(--it-track-mono-sm);
    margin-top: 8px;
    text-transform: uppercase;
    font-style: normal;
  }

  .epk-sec h2 {
    font-family: var(--it-font-display);
    font-size: clamp(34px, 5vw, 56px);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--it-cream);
    margin: 0 0 28px;
  }

  /* ---- Bio prose ---- */
  .epk-bio p {
    font-family: var(--it-font-body);
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 20px;
    opacity: 0.9;
    max-width: 64ch;
    color: var(--it-cream);
  }

  .epk-bio p em { font-style: italic; color: var(--it-orange); }
  .epk-bio p strong { color: var(--it-cream); font-weight: 800; }

  .epk-bio__variants {
    margin-top: 32px;
    display: grid;
    gap: 12px;
  }

  .epk-bio__variant {
    border: 1px solid rgba(245, 245, 220, 0.14);
    background: var(--it-ink);
    padding: 20px 22px;
  }

  .vk {
    font-family: var(--it-font-mono);
    font-size: 10px;
    letter-spacing: var(--it-track-mono-md);
    text-transform: uppercase;
    color: var(--it-orange);
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
  }

  .epk-bio__variant p {
    font-family: var(--it-font-body);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.82;
    color: var(--it-cream);
    max-width: none;
  }

  /* ---- Quick facts stat band (inline) ---- */
  .epk-statband {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--it-orange-30);
    margin-top: 24px;
  }

  .epk-statband .stat {
    padding: 24px 20px;
    border-right: 1px solid var(--it-orange-30);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .epk-statband .stat:last-child { border-right: none; }

  .epk-statband .stat__n {
    font-family: var(--it-font-display);
    font-size: clamp(32px, 4vw, 56px);
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-orange);
  }

  .epk-statband .stat__k {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    color: var(--it-cream);
  }

  .epk-statband .stat__sub {
    font-family: var(--it-font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: rgba(245, 245, 220, 0.35);
  }

  /* ---- Bio facts ---- */
  .bio__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--it-orange-30);
    border: 1px solid var(--it-orange-30);
  }

  .fact {
    background: var(--it-black);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact__k {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    color: var(--it-orange);
  }

  .fact__v {
    font-family: var(--it-font-display);
    font-size: 26px;
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-cream);
  }

  .fact__sub {
    font-family: var(--it-font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: rgba(245, 245, 220, 0.35);
  }

  /* ---- Members ---- */
  .members { display: flex; flex-direction: column; }

  .member {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--it-orange-30);
  }

  .member:first-child { border-top: 1px solid var(--it-orange-30); }

  .member__num {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: var(--it-orange);
  }

  .member__name {
    font-family: var(--it-font-display);
    font-size: 22px;
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-cream);
  }

  .member__role {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: rgba(245, 245, 220, 0.4);
    text-align: right;
  }

  /* ---- Releases (EPK even grid) ---- */
  .releases--even {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 12px;
  }

  .release {
    position: relative;
    border: 1px solid var(--it-orange-30);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .release--wh { border-color: var(--it-wh-violet-30); }
  .release--secondary { border-color: rgba(211, 47, 47, 0.3); }

  .release__tag {
    position: absolute;
    top: 12px;
