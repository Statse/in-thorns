---

---

<nav class="nav" id="nav" aria-label="Main">
  <a href="/" class="nav__logo">IN THORNS</a>
  <button
    class="nav__burger"
    id="nav-burger"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-links"
  >
    <span></span><span></span><span></span>
  </button>
  <ul class="nav__links" id="nav-links">
    <li><a href="/#single">Single</a></li>
    <li><a href="/#tour">Tour</a></li>
    <li><a href="/#gallery">Images</a></li>
    <li><a href="/#bio">Bio</a></li>
    <li><a href="/#contact">Booking</a></li>
    <li><a href="/press-kit" class="nav__cta">Press kit</a></li>
  </ul>
  <div class="nav__overlay" id="nav-overlay" aria-hidden="true"></div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 48px;
    transition:
      background 300ms,
      border-color 300ms;
  }

  .nav.scrolled {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--it-orange-30);
  }

  .nav__logo {
    font-family: var(--it-font-display);
    font-size: 18px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--it-cream);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 200ms;
    position: relative;
    z-index: 52;
  }

  .nav__logo::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--it-orange);
    flex-shrink: 0;
  }

  .nav__logo:hover {
    color: var(--it-orange);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links a {
    font-family: var(--it-font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    text-decoration: none;
    color: rgba(245, 245, 220, 0.7);
    transition: color 200ms;
  }

  .nav__links a:hover,
  .nav__links a.active {
    color: var(--it-orange);
  }

  .nav__links a.nav__cta {
    border: 1px solid var(--it-orange-30);
    padding: 7px 14px;
    color: var(--it-cream);
    transition: border-color 180ms, color 180ms;
  }

  .nav__links a.nav__cta:hover {
    border-color: var(--it-orange);
    color: var(--it-orange);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    position: relative;
    z-index: 52;
  }

  .nav__burger span {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--it-cream);
    transition:
      transform 300ms,
      opacity 300ms;
  }

  .nav__overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 49;
  }

  @media (max-width: 900px) {
    .nav {
      padding: 16px 20px;
    }

    .nav__burger {
      display: flex;
    }

    .nav__links {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 280px;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--it-ink);
      border-left: 1px solid var(--it-orange-30);
      padding: 80px 32px 40px;
      transform: translateX(100%);
      transition: transform 320ms cubic-bezier(0.4, 0, 0.1, 1);
      z-index: 51;
    }

    .nav__links.open {
      transform: translateX(0);
    }

    .nav__links li {
      width: 100%;
      border-bottom: 1px solid rgba(245, 245, 220, 0.08);
    }

    .nav__links a {
      display: block;
      padding: 16px 0;
      font-size: 12px;
    }

    .nav__overlay.open {
      display: block;
    }

    .nav__burger[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .nav__burger[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    .nav__burger[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

<script>
  function initNav() {
    // Abort previous listeners so re-runs don't stack handlers
    (window as any).__navAC?.abort();
    const ac = new AbortController();
    (window as any).__navAC = ac;
    const { signal } = ac;

    const nav = document.getElementById("nav");
    const burger = document.getElementById("nav-burger");
    const links = document.getElementById("nav-links");
    const overlay = document.getElementById("nav-overlay");
    if (!nav || !burger || !links || !overlay) return;

    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle("scrolled", y > 60);
      const navAnchors = links.querySelectorAll<HTMLAnchorElement>("a");
      const sections = document.querySelectorAll<HTMLElement>(
        "section[id], header[id]",
      );
      let current = "";
      sections.forEach((s) => {
        if (y >= s.offsetTop - 180) current = s.id;
      });
      navAnchors.forEach((a) => {
        const href = a.getAttribute("href") || "";
        a.classList.toggle(
          "active",
          href === `#${current}` || href === `/#${current}`,
        );
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    onScroll();

    const openDrawer = () => {
      links.classList.add("open");
      overlay.classList.add("open");
      burger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };
    const closeDrawer = () => {
      links.classList.remove("open");
      overlay.classList.remove("open");
      burger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };

    burger.addEventListener(
      "click",
      () => {
        links.classList.contains("open") ? closeDrawer() : openDrawer();
      },
      { signal },
    );
    overlay.addEventListener("click", closeDrawer, { signal });
    links
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", closeDrawer, { signal }));
  }

  document.addEventListener("astro:page-load", initNav);
</script>
