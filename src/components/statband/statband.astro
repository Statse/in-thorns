---
import type { TourEvent } from "@/types/bandsintown";
import { releases } from "@/data/releases";

interface Props {
  events?: TourEvent[];
}

const { events = [] } = Astro.props;
const hasTour = events.length > 0;
const thirdStat = hasTour
  ? {
      n: String(events.length).padStart(2, "0"),
      k: "Upcoming dates",
      sub: "Live · Bandsintown",
    }
  : {
      n: String(releases.length).padStart(2, "0"),
      k: "Releases",
      sub: "Singles + album",
    };
---

<div class="statband" aria-label="Band facts">
  <div class="stat">
    <div class="stat__n">'22</div>
    <div class="stat__k">Established</div>
    <div class="stat__sub">Jyväskylä, Central FI</div>
  </div>
  <div class="stat">
    <div class="stat__n">05</div>
    <div class="stat__k">Members</div>
    <div class="stat__sub">Three-vocalist attack</div>
  </div>
  <div class="stat">
    <div class="stat__n">{thirdStat.n}</div>
    <div class="stat__k">{thirdStat.k}</div>
    <div class="stat__sub">{thirdStat.sub}</div>
  </div>
  <div class="stat">
    <div class="stat__n">#8</div>
    <div class="stat__k">Top 10 newcomer '24</div>
    <div class="stat__sub">Vuoden tulokas · Kaaoszine</div>
  </div>
</div>

<style>
  .statband {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--it-orange-30);
    border-bottom: 1px solid var(--it-orange-30);
  }

  .stat {
    padding: 48px 32px;
    border-right: 1px solid var(--it-orange-30);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat:last-child {
    border-right: none;
  }

  .stat__n {
    font-family: var(--it-font-display);
    font-size: clamp(56px, 7vw, 104px);
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-orange);
  }

  .stat__k {
    font-family: var(--it-font-mono);
    font-size: var(--it-fs-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    color: var(--it-cream);
  }

  .stat__sub {
    font-family: var(--it-font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: rgba(245, 245, 220, 0.35);
  }

  @media (max-width: 900px) {
    .statband {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat:nth-child(2) {
      border-right: none;
    }
    .stat:nth-child(1),
    .stat:nth-child(2) {
      border-bottom: 1px solid var(--it-orange-30);
    }
    .stat {
      padding: 32px 24px;
    }
  }

  @media (max-width: 480px) {
    .statband {
      grid-template-columns: 1fr;
    }
    .stat {
      border-right: none !important;
      border-bottom: 1px solid var(--it-orange-30);
    }
    .stat:last-child {
      border-bottom: none;
    }
  }
</style>
