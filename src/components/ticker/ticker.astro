---
import type { TourEvent } from '@/types/bandsintown'

interface Props {
  events?: TourEvent[]
}

const { events = [] } = Astro.props

// Build tour string from up to 4 nearest events
const tourDates = events.slice(0, 4)
const tourText = tourDates.length > 0
  ? 'TOUR — ' + tourDates.map(e => {
      const d = new Date(e.datetime)
      const day = d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }).toUpperCase()
      return `${day} ${e.city.toUpperCase()}`
    }).join(' · ')
  : null
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    <span>NEW SINGLE — WORMHUSK — OUT NOW · MAY 29 2026</span>
    {tourText && <span class="ticker__tour">{tourText}</span>}
    <span>TOP 10 NEWCOMER OF THE YEAR 2024 — KAAOSZINE</span>
    <span>EXIT WOUNDS — OUT NOW — JAN 23 2026</span>
    <span>BOOKING NOW OPEN — AUTUMN '26</span>
    <!-- Duplicate for seamless loop -->
    <span>NEW SINGLE — WORMHUSK — OUT NOW · MAY 29 2026</span>
    {tourText && <span class="ticker__tour">{tourText}</span>}
    <span>TOP 10 NEWCOMER OF THE YEAR 2024 — KAAOSZINE</span>
    <span>EXIT WOUNDS — OUT NOW — JAN 23 2026</span>
    <span>BOOKING NOW OPEN — AUTUMN '26</span>
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    border-top: 1px solid var(--it-orange-30);
    border-bottom: 1px solid var(--it-orange-30);
    background: var(--it-black);
  }

  .ticker__track {
    display: flex;
    gap: 0;
    white-space: nowrap;
    animation: ticker-scroll 42s linear infinite;
  }

  .ticker__track span {
    font-family: var(--it-font-display);
    font-size: 28px;
    letter-spacing: var(--it-track-display);
    text-transform: uppercase;
    color: var(--it-cream);
    padding: 14px 0;
    flex-shrink: 0;
  }

  /* Orange bullet separator between spans */
  .ticker__track span::after {
    content: ' ·';
    color: var(--it-orange);
    margin: 0 32px;
  }

  .ticker__track span:last-child::after {
    display: none;
  }

  .ticker__tour {
    color: var(--it-orange) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
      overflow-x: auto;
      flex-wrap: nowrap;
    }
  }
</style>
