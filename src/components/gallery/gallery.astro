---
// Photo gallery section — asymmetric masonry grid per handover spec
const photos = [
  { src: '/photos/live/poppari_2025/_X2A6176.webp', alt: 'In Thorns live at Poppari 2025 — lead vocalist', caption: 'Live · Poppari 2025' },
  { src: '/photos/exit_wounds/1.webp', alt: 'exit wounds promotional photo — In Thorns', caption: 'Promo · exit wounds' },
  { src: '/photos/live/poppari_2025/_X2A5650.webp', alt: 'In Thorns live — wide stage shot', caption: 'Live · wide' },
  { src: '/photos/tlbocos/2A2FE513-7654-45A3-9120-25FAD6AFF06C.webp', alt: 'the last bead on a cord of songs session', caption: 'Archive · tlboacos' },
  { src: '/photos/live/poppari_2025/_X2A7434.webp', alt: 'In Thorns live — crowd perspective', caption: 'Live · crowd' },
]
---

<section id="gallery">
  <div class="wrap">
    <div class="section__head">
      <div>
        <div class="section__num">04 / MEDIA</div>
        <div class="section__sub">Live · Promo · Archive</div>
      </div>
      <h2 class="section__title">Images</h2>
    </div>

    <div class="gallery">
      {photos.map(photo => (
        <a href="/gallery" class="gallery__item">
          <img src={photo.src} alt={photo.alt} loading="lazy" />
          <figcaption class="gallery__caption">{photo.caption}</figcaption>
        </a>
      ))}
    </div>

    <div class="gallery__footer">
      <a class="it-btn" href="/gallery">Open full gallery →</a>
    </div>
  </div>
</section>

<style>
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  section {
    padding: 96px 0;
    border-bottom: 1px solid var(--it-orange-30);
  }

  .gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, 280px);
    gap: 12px;
  }

  .gallery__item {
    position: relative;
    overflow: hidden;
    background: var(--it-ink);
    display: block;
    text-decoration: none;
  }

  .gallery__item:nth-child(1) {
    grid-row: span 2;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.1) contrast(1.05);
    transition: transform 700ms ease, filter 700ms ease;
  }

  .gallery__item:hover img {
    transform: scale(1.06);
    filter: none;
  }

  .gallery__caption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    color: var(--it-cream);
    background: rgba(0, 0, 0, 0.7);
    padding: 6px 10px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .gallery__footer {
    margin-top: 32px;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 720px) {
    .wrap { padding: 0 20px; }
    section { padding: 64px 0; }

    .gallery {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px 200px;
    }

    .gallery__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 480px) {
    .gallery {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .gallery__item,
    .gallery__item:nth-child(1) {
      grid-column: span 1;
      grid-row: span 1;
      height: 240px;
    }
  }
</style>
