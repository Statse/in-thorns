---
// Bio / The Collective section
const members = [
  { num: '01', name: 'Kristian Ruutala',    role: 'Harsh Vocals' },
  { num: '02', name: 'Aleksi Statsevich',   role: 'Harsh Vocals' },
  { num: '03', name: 'Aavee Tikkanen',      role: 'Vocals · Guitar' },
  { num: '04', name: 'Aleksi Ruotsalainen', role: 'Guitar' },
  { num: '05', name: 'Jimi Kinnunen',       role: 'Drums' },
]

const facts = [
  { k: 'Origin',     v: 'Jyväskylä', sub: 'Central Finland · est. 2022' },
  { k: 'Genre',      v: 'Metalcore',  sub: 'Post · alternative · surrealist' },
  { k: 'Members',    v: '5',          sub: 'Two-vocalist attack' },
  { k: 'Accolades',  v: "#8 '24",     sub: 'Vuoden tulokas · Kaaoszine' },
]
---

<section id="bio">
  <div class="wrap">
    <div class="section__head">
      <div>
        <div class="section__num">03 / BIO</div>
        <div class="section__sub">Who &amp; what · Press</div>
      </div>
      <h2 class="section__title">The<br />Collective</h2>
    </div>

    <div class="pressline">
      <div>
        <div class="pressline__quote">Top 10 newcomer of the year, <em>2024.</em></div>
        <div class="pressline__src">— Kaaoszine readers' poll · 5,000+ voters</div>
      </div>
      <div class="pressline__cta">
        <a class="it-btn" href="/press-kit"><span>Open full EPK</span><span>↗</span></a>
        <a class="it-btn it-btn--ghost" href="/press-kit#photos"><span>Press photos</span><span>↓</span></a>
      </div>
    </div>

    <div class="bio">
      <div class="bio__text">
        <p>
          Jyväskylä-based metal collective In Thorns creates music driven by crushing soundscapes, nihilistic and darkly poetic lyrics, and soaring melodies. Their acclaimed 2024 debut <em>"the last bead on a cord of songs"</em> placed top 10 in Kaaoszine's newcomer of the year readers' poll; the new single cycle — <em>"exit wounds"</em> and <em>"wormhusk"</em> — pushes heavier and leaner. Drawing from surrealist art and horror, the live show pulls audiences into their dark, surreal world.
        </p>

        <div class="bio__facts">
          {facts.map(f => (
            <div class="fact">
              <div class="fact__k">{f.k}</div>
              <div class="fact__v">{f.v}</div>
              <div class="fact__sub">{f.sub}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="members">
        {members.map(m => (
          <div class="member">
            <div class="member__num">{m.num}</div>
            <div class="member__name">{m.name}</div>
            <div class="member__role">{m.role}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  section {
    padding: 88px 0;
    border-bottom: 1px solid var(--it-orange-30);
  }

  /* Pressline strip */
  .pressline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    border: 1px solid var(--it-orange-30);
    background: var(--it-ink);
    padding: 28px 36px;
    margin-bottom: 56px;
  }

  .pressline__quote {
    font-family: var(--it-font-display);
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--it-cream);
  }

  .pressline__quote em {
    font-style: normal;
    color: var(--it-orange);
  }

  .pressline__src {
    font-family: var(--it-font-mono);
    font-size: 11px;
    letter-spacing: var(--it-track-mono-md);
    text-transform: uppercase;
    color: var(--it-cream);
    opacity: 0.55;
    margin-top: 10px;
  }

  .pressline__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bio {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
  }

  /* Prose */
  .bio__text p {
    font-family: var(--it-font-body);
    font-weight: 800;
    font-size: 19px;
    line-height: var(--it-lh-body);
    color: rgba(245, 245, 220, 0.85);
    margin: 0 0 24px;
    max-width: 64ch;
  }

  .bio__text p em {
    font-style: italic;
    color: var(--it-cream);
  }

  /* Facts grid */
  .bio__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--it-orange-30);
    border: 1px solid var(--it-orange-30);
    margin-top: 40px;
  }

  .fact {
    background: var(--it-black);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact__k {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    color: var(--it-orange);
  }

  .fact__v {
    font-family: var(--it-font-display);
    font-size: 26px;
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-cream);
  }

  .fact__sub {
    font-family: var(--it-font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: rgba(245, 245, 220, 0.35);
  }

  /* Members roster */
  .members {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .member {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--it-orange-30);
  }

  .member:first-child { border-top: 1px solid var(--it-orange-30); }

  .member__num {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: var(--it-orange);
  }

  .member__name {
    font-family: var(--it-font-display);
    font-size: 22px;
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-cream);
  }

  .member__role {
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: rgba(245, 245, 220, 0.4);
    text-align: right;
  }

  @media (max-width: 900px) {
    .bio { grid-template-columns: 1fr; gap: 48px; }
  }

  @media (max-width: 720px) {
    .wrap { padding: 0 20px; }
    section { padding: 64px 0; }
    .pressline { padding: 24px 20px; }
    .member { grid-template-columns: 40px 1fr; }
    .member__role { grid-column: 2; text-align: left; }
  }
</style>
