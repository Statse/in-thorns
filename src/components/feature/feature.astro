---
// Featured single spread — Wormhusk
---

<section id="single">
  <div class="wrap">
    <div class="section__head">
      <div>
        <div class="section__num">01 / NEW SINGLE</div>
        <div class="section__sub">Out May 29, 2026</div>
      </div>
      <h2 class="section__title">Latest</h2>
    </div>

    <article class="feature feature--wh">
      <div class="feature__cover">
        <span class="release__tag">New — May 29</span>
        <img
          src="/music/WH SINGLE ART.png"
          alt="wormhusk — In Thorns single artwork"
          width="800"
          height="800"
          loading="lazy"
        />
      </div>
      <div class="feature__body">
        <div class="feature__eyebrow">Single · 2026</div>
        <h3 class="feature__title">worm<br /><em>husk.</em></h3>
        <div class="feature__meta">Self-released · all DSPs · 29.05.2026</div>
        <p class="feature__desc">
          "what's left when the husk falls quiet." The second single of the cycle — claustrophobic, oppressive, and built around a slow violet dread.
        </p>
        <div class="feature__cta">
          <a
            class="it-btn it-btn--primary"
            href="https://distrokid.com/hyperfollow/inthorns/wormhusk"
            target="_blank"
            rel="noopener"
          >
            <span>Listen</span><span>→</span>
          </a>
          <div class="feature__links">
            <a class="it-chip" href="https://open.spotify.com/artist/4b0Yziy8xm1VtefVI9ri2d" target="_blank" rel="noopener">Spotify</a>
            <a class="it-chip" href="https://www.youtube.com/@inthornsband" target="_blank" rel="noopener">YouTube</a>
            <a class="it-chip" href="#press">Press assets →</a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  section {
    padding: 96px 0;
    border-bottom: 1px solid var(--it-orange-30);
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
    padding: 48px;
    border: 1px solid var(--it-orange-30);
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.03) 0%, transparent 60%);
  }

  .feature--wh {
    border-color: var(--it-wh-violet-30);
    background: linear-gradient(135deg, rgba(157, 82, 194, 0.05) 0%, transparent 60%);
  }

  /* Cover */
  .feature__cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .feature__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
    box-shadow: var(--it-shadow-soft);
  }

  .feature__cover:hover img { transform: scale(1.04); }

  .release__tag {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    font-family: var(--it-font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    background: var(--it-orange);
    color: var(--it-black);
    padding: 6px 10px;
  }

  .feature--wh .release__tag {
    background: var(--it-wh-violet);
    color: var(--it-cream);
  }

  /* Body */
  .feature__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
  }

  .feature__eyebrow {
    font-family: var(--it-font-mono);
    font-size: var(--it-fs-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-md);
    color: var(--it-orange);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .feature--wh .feature__eyebrow { color: var(--it-wh-violet-light); }

  .feature__eyebrow::before {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    background: currentColor;
  }

  .feature__title {
    font-family: var(--it-font-display);
    font-size: clamp(56px, 8vw, 120px);
    line-height: var(--it-lh-display);
    text-transform: uppercase;
    letter-spacing: var(--it-track-display);
    color: var(--it-cream);
    margin: 0;
  }

  .feature__title em {
    font-style: normal;
    color: var(--it-orange);
  }

  .feature--wh .feature__title em {
    color: var(--it-wh-violet-light);
  }

  .feature__meta {
    font-family: var(--it-font-mono);
    font-size: var(--it-fs-mono);
    text-transform: uppercase;
    letter-spacing: var(--it-track-mono-sm);
    color: var(--it-orange);
    opacity: 0.8;
  }

  .feature--wh .feature__meta { color: var(--it-wh-violet-light); }

  .feature__desc {
    font-family: var(--it-font-body);
    font-weight: 800;
    font-size: 19px;
    line-height: var(--it-lh-body);
    color: var(--it-cream);
    opacity: 0.85;
    margin: 0;
    max-width: 48ch;
  }

  .feature__cta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 900px) {
    .wrap { padding: 0 20px; }
    section { padding: 64px 0; }

    .feature {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 24px;
    }
  }
</style>
